PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/panasecreto
CORS_ORIGIN=*
# Mínimo 32 caracteres aleatorios en staging/production (openssl rand -hex 32)
JWT_KEY=
CLOUD_NAME=mi_nombre
CLOUDINARY_KEY=CLOUDINARY_CODE_KEY
CLOUDINARY_SECRET=CLOUDINARY_CODE_SECRET
FOLDER_NAME=EntrePanas
# Admin semilla (en staging/production es obligatorio definir la contraseña)
USER_ADMIN_EMAIL=admin@panasecreto.local
USER_ADMIN_PASSWORD=
USER_ADMIN_NAME=Administrador
# Costo de bcrypt (mínimo 10)
BCRYPT_ROUNDS=10

# Correo transaccional (Mailjet). Sin claves, los correos solo se imprimen en consola.
MJ_APIKEY_PUBLIC=
MJ_APIKEY_PRIVATE=
MAIL_FROM_EMAIL=entrepanas@erdesarrollo.com.ve
MAIL_FROM_NAME=EntrePanas
# Opcional: logo de los correos (por defecto, el subido con `pnpm --filter @panasecreto/backend mail:logo`)
MAIL_LOGO_URL=
# MAIL_TRANSPORT=log   # fuerza modo consola aunque haya claves

# URLs públicas usadas en los enlaces de los correos
APP_PUBLIC_URL=https://entrepanas.app
ADMIN_PUBLIC_URL=https://admin.entrepanas.app
# UPLOAD_TRANSPORT=mock   # simula Cloudinary (tests / desarrollo sin credenciales)

# URL pública de esta API (https). Google vuelve aquí después de iniciar sesión.
# En desarrollo con el teléfono, usa un túnel (p. ej. `cloudflared tunnel --url http://localhost:4000`).
API_PUBLIC_URL=http://localhost:4000

# Enlaces de invitación (<API_PUBLIC_URL>/join/PANA-XXXX-XX): con qué dirección se abre la app.
# App instalada: entrepanas://   ·   Pruebas con Expo Go: exp://IP-DE-TU-PC:8081/--/
APP_LINK_BASE=entrepanas://

# Notificaciones push (Expo). Por defecto se envían por el servicio de Expo; no hace falta configurar nada.
# PUSH_TRANSPORT=expo          # 'log' para no enviar (solo registrar)
# EXPO_ACCESS_TOKEN=           # solo si activas «Enhanced push security» en expo.dev
# PUSH_TIMEZONE=America/Caracas  # los recordatorios no se envían como push entre 9 p. m. y 8 a. m.

# Iniciar sesión con Google (Google Cloud Console → Credenciales → ID de cliente OAuth "Aplicación web")
# URI de redirección autorizada: <API_PUBLIC_URL>/api/user/google/callback
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
# Opcional: ID de clientes Android/iOS si en el futuro se usa el inicio de sesión nativo (separados por coma)
GOOGLE_EXTRA_CLIENT_IDS=
# Esquemas de la app permitidos para volver (entrepanas = app instalada; exp/exps = Expo Go)
GOOGLE_APP_REDIRECT_SCHEMES=entrepanas,exp,exps
