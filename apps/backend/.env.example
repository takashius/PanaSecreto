PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/panasecreto
CORS_ORIGIN=*
# Mínimo 32 caracteres aleatorios en staging/production (openssl rand -hex 32)
JWT_KEY=
CLOUD_NAME=mi_nombre
CLOUDINARY_KEY=CLOUDINARY_CODE_KEY
CLOUDINARY_SECRET=CLOUDINARY_CODE_SECRET
FOLDER_NAME=PanaSecreto
# Admin semilla (en staging/production es obligatorio definir la contraseña)
USER_ADMIN_EMAIL=admin@panasecreto.local
USER_ADMIN_PASSWORD=
USER_ADMIN_NAME=Administrador
# Costo de bcrypt (mínimo 10)
BCRYPT_ROUNDS=10
