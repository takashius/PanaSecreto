PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/panasecreto
CORS_ORIGIN=*
# Mínimo 32 caracteres aleatorios en staging/production (openssl rand -hex 32)
JWT_KEY=
CLOUD_NAME=mi_nombre
CLOUDINARY_KEY=CLOUDINARY_CODE_KEY
CLOUDINARY_SECRET=CLOUDINARY_CODE_SECRET
FOLDER_NAME=EntrePanas
# Admin semilla (en staging/production es obligatorio definir la contraseña)
USER_ADMIN_EMAIL=admin@panasecreto.local
USER_ADMIN_PASSWORD=
USER_ADMIN_NAME=Administrador
# Costo de bcrypt (mínimo 10)
BCRYPT_ROUNDS=10

# Correo transaccional (Mailjet). Sin claves, los correos solo se imprimen en consola.
MJ_APIKEY_PUBLIC=
MJ_APIKEY_PRIVATE=
MAIL_FROM_EMAIL=entrepanas@erdesarrollo.com.ve
MAIL_FROM_NAME=EntrePanas
# Opcional: logo de los correos (por defecto, el subido con `pnpm --filter @panasecreto/backend mail:logo`)
MAIL_LOGO_URL=
# MAIL_TRANSPORT=log   # fuerza modo consola aunque haya claves

# URLs públicas usadas en los enlaces de los correos
APP_PUBLIC_URL=https://entrepanas.app
ADMIN_PUBLIC_URL=https://admin.entrepanas.app
# UPLOAD_TRANSPORT=mock   # simula Cloudinary (tests / desarrollo sin credenciales)
