# URL de la API. Sin definirla, en Expo Go se usa la IP de tu computadora (la misma de Metro) con el puerto 4000.
# Ejemplos: http://192.168.1.10:4000  ·  https://api.entrepanas.app
EXPO_PUBLIC_API_URL=

# En builds de producción, fuerza el log de peticiones/respuestas en consola (opcional).
# EXPO_PUBLIC_API_DEBUG=true

# (Opcional) Base de los enlaces de invitación que se comparten: <base>/join/PANA-XXXX-XX
# Sin definirla se usa la URL de la API, que sirve esa página y abre la app.
EXPO_PUBLIC_INVITE_URL=
