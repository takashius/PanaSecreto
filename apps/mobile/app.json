{
  "expo": {
    "name": "EntrePanas",
    "slug": "panasecreto",
    "owner": "erdesarrollo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "../../assets/logos/logo-principal-transparente.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F7F2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.erdesarrollo.entrepanas"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FEC414"
      },
      "package": "com.erdesarrollo.entrepanas",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#00000000",
      "barStyle": "dark-content"
    },
    "androidNavigationBar": {
      "visible": "always",
      "backgroundColor": "#00000000",
      "barStyle": "dark-content",
      "enforceContrast": false
    },
    "plugins": [
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "EntrePanas usa tus fotos para que agregues imágenes a tu lista de deseos.",
          "cameraPermission": "EntrePanas usa la cámara para que tomes fotos de los regalos que deseas."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "expo-navigation-bar": {
        "enforceContrast": false
      },
      "eas": {
        "projectId": "c2c44d31-45f4-476c-82c9-aba855c3f5b0"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c2c44d31-45f4-476c-82c9-aba855c3f5b0"
    }
  }
}
