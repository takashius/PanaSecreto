{
  "name": "panasecreto-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev:backend": "pnpm --filter @panasecreto/backend dev",
    "dev:admin": "pnpm --filter @panasecreto/admin dev",
    "dev:mobile": "pnpm --filter @panasecreto/mobile start",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter @panasecreto/backend build && pnpm --filter @panasecreto/admin build",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r exec rimraf dist .turbo node_modules",
    "test": "pnpm -r --if-present test",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "8.71.1"
  }
}
